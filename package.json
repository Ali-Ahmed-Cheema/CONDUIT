{
  "name": "conduit-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm --prefix frontend/conduit run dev",
    "dev:api": "npm --prefix frontend/conduit run dev:api",
    "dev:web": "npm --prefix frontend/conduit run dev:web",
    "dev:reference": "vite --port 5174",
    "start:api": "npm --prefix frontend/conduit run start:api",
    "start": "npm --prefix frontend/conduit run start",
    "build": "npm --prefix frontend/conduit run build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.quality.json && npm --prefix frontend/conduit run typecheck",
    "preview": "npm --prefix frontend/conduit run preview",
    "generate:verify": "npm --prefix frontend/conduit run generate:verify",
    "generate:key": "node frontend/conduit/scripts/generate-key.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.17",
    "@types/express": "^5.0.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.4",
    "lucide-react": "^0.542.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.0.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.0.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
