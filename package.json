{
  "name": "conduit-workspace",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "packageManager": "pnpm@10.34.9",
  "scripts": {
    "dev": "corepack pnpm --filter @conduit/web dev",
    "dev:api": "corepack pnpm --filter @conduit/web dev:api",
    "dev:web": "corepack pnpm --filter @conduit/web dev:web",
    "dev:reference": "corepack pnpm --filter @conduit/credential-reference dev",
    "start:api": "corepack pnpm --filter @conduit/web start:api",
    "start": "corepack pnpm --filter @conduit/web start",
    "build": "corepack pnpm --filter @conduit/web build",
    "build:workspace": "turbo run build --filter=@conduit/web --filter=@conduit/credential-reference",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.quality.json && corepack pnpm --filter @conduit/web typecheck && corepack pnpm --filter @conduit/credential-reference typecheck && corepack pnpm --filter @conduit/ui typecheck && corepack pnpm --filter @conduit/crypto typecheck && corepack pnpm --filter @conduit/storage typecheck && corepack pnpm --filter @conduit/agent typecheck && corepack pnpm --filter @conduit/rag typecheck && corepack pnpm --filter @conduit/plugin-sdk typecheck",
    "prepare": "husky",
    "changeset": "changeset",
    "sbom": "node scripts/generate-sbom.mjs",
    "preview": "corepack pnpm --filter @conduit/web preview",
    "generate:verify": "corepack pnpm --filter @conduit/web generate:verify",
    "generate:key": "node apps/web/scripts/generate-key.mjs",
    "generate:api": "tsx scripts/generate-openapi.ts && openapi-typescript apps/web/openapi.json -o apps/web/src/generated/openapi.d.ts",
    "check:api": "corepack pnpm generate:api && git diff --exit-code -- apps/web/openapi.json apps/web/src/generated/openapi.d.ts",
    "lint-staged": "lint-staged"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.17",
    "@types/express": "^5.0.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.4",
    "lucide-react": "^0.542.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@changesets/cli": "3.0.3",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@cyclonedx/cyclonedx-npm": "6.0.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.0.0",
    "husky": "9.1.7",
    "jsdom": "^30.1.3",
    "lint-staged": "17.6.0",
    "openapi-typescript": "7.13.0",
    "prettier": "^3.0.0",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "turbo": "^2.11.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  },
  "lint-staged": {
    "*.{js,mjs,ts,tsx}": [
      "eslint --fix"
    ],
    "*.{md,json,yml,yaml}": [
      "prettier --write"
    ]
  }
}
