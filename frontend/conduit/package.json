{
  "name": "conduit-v3",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/index.ts",
    "dev:web": "vite",
    "start:api": "tsx server/index.ts",
    "start": "tsx server/index.ts --production",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "generate:verify": "node scripts/generate-verifier.mjs",
    "generate:key": "node scripts/generate-key.mjs"
  },
  "dependencies": {
    "@tanstack/react-virtual": "^3.14.17",
    "@types/express": "^5.0.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "hash-wasm": "^4.12.0",
    "idb": "^8.0.4",
    "lucide-react": "^0.542.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "concurrently": "^10.0.6",
    "eslint": "^9.0.0",
    "prettier": "^3.0.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.0",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^4.1.11"
  }
}
